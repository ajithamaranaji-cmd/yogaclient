rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isPremium() { 
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && 
             exists(userPath) && 
             get(userPath).data.get('subscriptionExpiresAt', null) != null && 
             timestamp(get(userPath).data.subscriptionExpiresAt) > request.time;
    }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Validation
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             data.role in ['student', 'professional', 'admin'] &&
             data.email is string && data.email.size() <= 256;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
    }

    match /professionals/{userId} {
      allow get: if true; 
      allow list: if true;
      allow create, update: if isOwner(userId) || isAdmin();

      // Protected documents
      match /private/premium {
        allow get: if isSignedIn();
        allow write: if isOwner(userId) || isAdmin();
      }

      match /private/contact {
        allow get: if isSignedIn() && (
          isOwner(userId) || 
          (isPremium() && userId in getUserData().unlockedProfiles)
        );
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    match /leads/{leadId} {
      allow get: if isOwner(existing().studentId) || isOwner(existing().professionalId) || isAdmin();
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.professionalId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && incoming().studentId == request.auth.uid;
      allow update: if (isSignedIn() && (resource.data.professionalId == request.auth.uid || resource.data.studentId == request.auth.uid)) || isAdmin();
      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if isOwner(userId);
    }
  }
}
